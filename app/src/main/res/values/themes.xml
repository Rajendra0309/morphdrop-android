<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MorphDrop" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background of the splash screen -->
        <item name="windowSplashScreenBackground">@color/premium_off_white</item>
        <!-- Icon to be shown in the center of the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- The theme to use after the splash screen is done -->
        <item name="postSplashScreenTheme">@style/Theme.MorphDrop</item>
    </style>
</resources>